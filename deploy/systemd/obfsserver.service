[Unit]
Description=WireGuard traffic obfuscator (server side)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
# Adjust the wg-quick@ dependency above to your actual WireGuard interface
# name, or remove it if WireGuard runs elsewhere.

[Service]
Type=simple
# Dedicated unprivileged user — see deploy/install.sh, which creates it and
# grants CAP_NET_BIND_SERVICE via AmbientCapabilities below instead of
# running as root (needed only if listen_tls_addr/listen_wire_addr use a
# port < 1024, e.g. 443).
User=obfsvpn
Group=obfsvpn
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/obfsvpn

WorkingDirectory=/etc/obfsvpn
ExecStart=/usr/local/bin/obfsserver -config /etc/obfsvpn/obfsserver.yaml
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
